# ─────────────────────────────────────────────────────────
#  COPY THIS FILE TO .env AND FILL IN YOUR REAL VALUES
#  Never commit .env to GitHub — add it to .gitignore
# ─────────────────────────────────────────────────────────

# Port the server will run on
PORT=5000

# ── GMAIL SMTP SETTINGS ───────────────────────────────────
# Use your Gmail address here
EMAIL_USER=seyij556@gmail.com

# Generate an App Password (NOT your real Gmail password):
# Gmail → Settings → Security → 2-Step Verification → App Passwords
# Choose "Mail" + "Windows Computer", copy the 16-char password below
EMAIL_PASS=your_16_char_app_password_here

# Where contact form emails get delivered (your inbox)
EMAIL_TO=seyij556@gmail.com

# ── FRONTEND URL (for CORS) ───────────────────────────────
# During local dev use: http://localhost:3000  or  http://127.0.0.1:5500
# In production use your real domain, e.g.: https://www.yourdomain.com
FRONTEND_URL=http://localhost:5500
